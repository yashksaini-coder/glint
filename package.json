{
  "name": "glint",
  "version": "0.1.0",
  "description": "Type and speak with your eyebrows and your breath: webcam switch access on Presage SmartSpectra",
  "main": "dist/main.cjs",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "npm run build && electron .",
    "build": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:@smartspectra/node-sdk --outfile=dist/main.cjs --log-level=warning && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs --log-level=warning && esbuild src/renderer/app.ts --bundle --platform=browser --format=iife --outfile=dist/renderer.js --log-level=warning",
    "typecheck": "tsc",
    "smoke": "npm run build && node tools/smoke.ts /tmp/glint-smoke.png",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "keywords": [],
  "author": "Yash Saini",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Glint",
  "build": {
    "appId": "dev.glint.app",
    "productName": "Glint",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "src/renderer/index.html",
      "recordings/guided.jsonl",
      "package.json",
      "!node_modules/@smartspectra/node-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Accessibility",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/",
          "to": "smartspectra/"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
